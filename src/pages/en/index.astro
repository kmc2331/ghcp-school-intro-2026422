---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Curriculum from '../../components/Curriculum.astro';
import Campus from '../../components/Campus.astro';
import Faculty from '../../components/Faculty.astro';
import StudentLife from '../../components/StudentLife.astro';
import News from '../../components/News.astro';
import Access from '../../components/Access.astro';

const lang = 'en' as const;
---

<BaseLayout lang={lang}>
  <Hero lang={lang} />
  <About lang={lang} />
  <Curriculum lang={lang} />
  <Campus lang={lang} />
  <Faculty lang={lang} />
  <StudentLife lang={lang} />
  <News lang={lang} />
  <Access lang={lang} />
</BaseLayout>

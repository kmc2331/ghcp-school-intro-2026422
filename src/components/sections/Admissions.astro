---
import { getDict, type Lang } from '~/i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = getDict(lang);
---
<section id="admissions" class="relative bg-mist py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6 sm:px-10">
    <div class="max-w-2xl reveal">
      <p class="kicker">{d.admissions.kicker}</p>
      <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl leading-tight">{d.admissions.title}</h2>
      <p class="mt-5 text-stone leading-relaxed">{d.admissions.lead}</p>
    </div>
    <ol class="mt-16 relative border-l-2 border-moss2/30 ml-3 sm:ml-6 space-y-10">
      {d.admissions.steps.map((s, i) => (
        <li class="reveal pl-8 sm:pl-12 relative">
          <span class="absolute -left-[11px] top-1 w-5 h-5 rounded-full bg-moss2 ring-4 ring-mist"></span>
          <div class="flex flex-wrap items-baseline gap-3">
            <span class="font-display text-stone/50 text-sm">STEP {String(i + 1).padStart(2, '0')}</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-sand text-bark">{s.date}</span>
          </div>
          <h3 class="mt-2 text-xl font-medium">{s.title}</h3>
          <p class="mt-2 text-sm text-stone leading-relaxed max-w-prose2">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

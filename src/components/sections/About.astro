---
import { getDict, type Lang } from '~/i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = getDict(lang);
---
<section id="about" class="relative bg-mist py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 sm:px-10 grid gap-16 lg:grid-cols-12">
    <div class="lg:col-span-5 reveal">
      <p class="kicker">{d.about.kicker}</p>
      <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl leading-tight">{d.about.title}</h2>
      <p class="mt-6 text-stone leading-relaxed max-w-prose2">{d.about.lead}</p>
      <p class="mt-4 text-xs text-stone/70">{d.about.note}</p>
    </div>
    <ul class="lg:col-span-7 grid sm:grid-cols-2 gap-5">
      {d.about.points.map((p, i) => (
        <li class="reveal rounded-organic bg-white/60 backdrop-blur-sm p-7 border border-bark/5 shadow-[0_1px_0_rgba(63,46,30,0.04)]">
          <div class="text-moss2 font-display text-3xl">{String(i + 1).padStart(2, '0')}</div>
          <h3 class="mt-3 text-lg font-medium">{p.title}</h3>
          <p class="mt-2 text-sm text-stone leading-relaxed">{p.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

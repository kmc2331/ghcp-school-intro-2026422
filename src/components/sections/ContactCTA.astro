---
import { getDict, type Lang } from '~/i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = getDict(lang);
---
<section id="contact" class="relative bg-bark text-mist py-28 sm:py-36 overflow-hidden">
  <svg class="absolute -top-px inset-x-0 w-full text-mist" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,0 C240,80 480,80 720,40 C960,0 1200,0 1440,60 L1440,0 L0,0 Z" fill="currentColor" opacity="0.08" />
  </svg>
  <div class="mx-auto max-w-4xl px-6 text-center reveal">
    <p class="kicker text-sand">{d.contact.title ? 'Contact' : ''}</p>
    <h2 class="mt-3 text-3xl sm:text-5xl leading-tight font-display">{d.contact.title}</h2>
    <p class="mt-5 text-mist/75">{d.contact.lead}</p>
    <div class="mt-12 flex flex-wrap justify-center gap-4">
      <a href="#" class="inline-flex items-center gap-2 rounded-full bg-mist text-bark px-7 py-4 text-sm font-medium hover:bg-sand transition-colors">
        ✉ {d.contact.email}
      </a>
      <a href="#" class="inline-flex items-center gap-2 rounded-full bg-moss2 text-mist px-7 py-4 text-sm font-medium hover:bg-moss transition-colors">
        ✎ {d.contact.form}
      </a>
      <a href="#" class="inline-flex items-center gap-2 rounded-full border border-mist/40 text-mist px-7 py-4 text-sm font-medium hover:bg-mist/10 transition-colors">
        ⌖ {d.contact.social}
      </a>
    </div>
  </div>
</section>

---
import { getDict, type Lang } from '~/i18n/utils';
import { getCollection } from 'astro:content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = getDict(lang);

const all = await getCollection('news', (entry) => entry.data.lang === lang);
const items = all
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat(lang === 'ja' ? 'ja-JP' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<section id="news" class="relative bg-mist py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 sm:px-10">
    <div class="flex items-end justify-between flex-wrap gap-6 reveal">
      <div class="max-w-xl">
        <p class="kicker">{d.news.kicker}</p>
        <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl leading-tight">{d.news.title}</h2>
        <p class="mt-5 text-stone leading-relaxed">{d.news.lead}</p>
      </div>
      <a href="#" class="text-sm text-moss2 hover:underline">{d.news.more} →</a>
    </div>
    <ul class="mt-12 grid md:grid-cols-3 gap-6">
      {items.map((n) => (
        <li class="reveal">
          <article class="h-full rounded-organic bg-white/70 border border-bark/5 p-7 hover:-translate-y-1 transition-transform">
            <time datetime={n.data.date.toISOString()} class="text-xs text-stone">{fmt.format(n.data.date)}</time>
            <h3 class="mt-3 text-lg font-medium leading-snug">{n.data.title}</h3>
            <p class="mt-3 text-sm text-stone leading-relaxed line-clamp-3">{n.data.summary}</p>
            <span class="mt-5 inline-block text-xs text-moss2">{d.news.readMore} →</span>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

---
import { getDict, type Lang } from '~/i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = getDict(lang);
const portraits = [
  'https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=400&q=70',
  'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=400&q=70',
  'https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=400&q=70',
  'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=400&q=70',
];
---
<section id="faculty" class="relative bg-[#EFE7D6] py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 sm:px-10">
    <div class="max-w-2xl reveal">
      <p class="kicker">{d.faculty.kicker}</p>
      <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl leading-tight">{d.faculty.title}</h2>
      <p class="mt-5 text-stone leading-relaxed">{d.faculty.lead}</p>
      <p class="mt-2 text-xs text-stone/70">{d.faculty.note}</p>
    </div>
    <ul class="mt-14 grid grid-cols-2 sm:grid-cols-4 gap-8">
      {d.faculty.members.map((m, i) => (
        <li class="reveal text-center">
          <div class="mx-auto w-32 h-32 sm:w-40 sm:h-40 rounded-full overflow-hidden ring-4 ring-mist shadow-md bg-sand">
            <img src={portraits[i % portraits.length]} alt={m.name} class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </div>
          <p class="mt-4 font-medium">{m.name}</p>
          <p class="text-xs text-stone mt-1">{m.role}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

---
import { useTranslations } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="campus" class="section-anchor py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-4">
    <p class="text-xs tracking-[0.25em] text-forest-600 font-medium">03 / CAMPUS</p>
    <h2 class="mt-2 text-3xl md:text-4xl font-bold text-forest-900">{t.campus.heading}</h2>
    <p class="mt-4 max-w-3xl text-bark/80 leading-relaxed">{t.campus.lead}</p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {t.campus.facilities.map((f) => (
        <div class="group rounded-2xl overflow-hidden border border-forest-100 bg-white shadow-sm">
          <div
            class="h-32 bg-gradient-to-br from-forest-200 via-forest-300 to-forest-500 group-hover:scale-[1.02] transition-transform"
            aria-hidden="true"
          ></div>
          <div class="p-4">
            <h3 class="font-bold text-forest-800">{f.name}</h3>
            <p class="mt-2 text-sm text-bark/75 leading-relaxed">{f.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

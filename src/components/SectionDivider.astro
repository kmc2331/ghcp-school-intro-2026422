---
interface Props {
  /** Color for the wave fill (matches the section ABOVE the divider) */
  from?: string;
  /** Color underneath the wave (matches the section BELOW) */
  to?: string;
  flip?: boolean;
  height?: number;
}
const { from = '#F5F2EB', to = '#E8DFCF', flip = false, height = 80 } = Astro.props;
---
<div class="relative w-full" style={`height:${height}px;background:${to};`}>
  <svg
    class={`absolute inset-x-0 ${flip ? 'bottom-0 rotate-180' : 'top-0'} w-full`}
    style={`height:${height}px;`}
    viewBox="0 0 1440 80"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d="M0,0 C240,80 480,80 720,40 C960,0 1200,0 1440,60 L1440,0 L0,0 Z"
      fill={from}
    />
  </svg>
</div>

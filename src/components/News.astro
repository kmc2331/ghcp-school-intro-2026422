---
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const all = await getCollection('news', ({ data }) => data.lang === lang);
const items = all
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const dateFmt = new Intl.DateTimeFormat(lang === 'ja' ? 'ja-JP' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<section id="news" class="section-anchor py-20 md:py-28 bg-forest-50/60">
  <div class="mx-auto max-w-6xl px-4">
    <p class="text-xs tracking-[0.25em] text-forest-600 font-medium">06 / NEWS</p>
    <h2 class="mt-2 text-3xl md:text-4xl font-bold text-forest-900">{t.news.heading}</h2>

    {items.length === 0 ? (
      <p class="mt-8 text-bark/70">{t.news.empty}</p>
    ) : (
      <ul class="mt-10 grid gap-6 md:grid-cols-3">
        {items.map((item) => (
          <li class="p-6 rounded-2xl bg-white border border-forest-100 shadow-sm">
            <time class="text-xs font-mono text-forest-500" datetime={item.data.date.toISOString()}>
              {dateFmt.format(item.data.date)}
            </time>
            <h3 class="mt-2 font-bold text-forest-800 leading-snug">{item.data.title}</h3>
            {item.data.summary && (
              <p class="mt-3 text-sm text-bark/75 leading-relaxed">{item.data.summary}</p>
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

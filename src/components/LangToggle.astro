---
import { localizedPath, type Lang } from '~/i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;

// Try to keep current path's hash by toggling root + /en/
const jaHref = localizedPath('ja', '/');
const enHref = localizedPath('en', '/');
---
<div class="inline-flex items-center rounded-full border border-bark/20 overflow-hidden text-xs font-medium select-none">
  <a
    href={jaHref}
    class={`px-3 py-1.5 transition-colors ${lang === 'ja' ? 'bg-bark text-mist' : 'text-bark/70 hover:bg-sand/60'}`}
    aria-current={lang === 'ja' ? 'true' : 'false'}
  >JP</a>
  <a
    href={enHref}
    class={`px-3 py-1.5 transition-colors ${lang === 'en' ? 'bg-bark text-mist' : 'text-bark/70 hover:bg-sand/60'}`}
    aria-current={lang === 'en' ? 'true' : 'false'}
  >EN</a>
</div>

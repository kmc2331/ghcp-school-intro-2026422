---
import { useTranslations } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="section-anchor py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-4">
    <p class="text-xs tracking-[0.25em] text-forest-600 font-medium">01 / ABOUT</p>
    <h2 class="mt-2 text-3xl md:text-4xl font-bold text-forest-900">{t.about.heading}</h2>
    <p class="mt-4 text-xl md:text-2xl font-display text-forest-700">{t.about.subheading}</p>
    <p class="mt-6 max-w-3xl text-bark/80 leading-relaxed">{t.about.body}</p>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {t.about.pillars.map((p, i) => (
        <article class="p-6 rounded-2xl bg-white/80 border border-forest-100 shadow-sm">
          <p class="text-xs font-mono text-forest-500">0{i + 1}</p>
          <h3 class="mt-2 text-lg font-bold text-forest-800">{p.title}</h3>
          <p class="mt-3 text-sm text-bark/75 leading-relaxed">{p.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

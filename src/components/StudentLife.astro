---
import { useTranslations } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="life" class="section-anchor py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-4 grid gap-10 lg:grid-cols-2 items-center">
    <div>
      <p class="text-xs tracking-[0.25em] text-forest-600 font-medium">05 / LIFE</p>
      <h2 class="mt-2 text-3xl md:text-4xl font-bold text-forest-900">{t.life.heading}</h2>
      <p class="mt-4 text-bark/80 leading-relaxed">{t.life.lead}</p>
      <ul class="mt-6 space-y-3">
        {t.life.points.map((p) => (
          <li class="flex gap-3 text-bark/85">
            <span class="mt-1 inline-block w-2 h-2 rounded-full bg-accent shrink-0"></span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="relative aspect-[4/3] rounded-3xl overflow-hidden border border-forest-100 shadow-sm">
      <div class="absolute inset-0 bg-gradient-to-br from-forest-200 via-forest-400 to-forest-700"></div>
      <div class="absolute inset-0 mist-overlay"></div>
      <div class="absolute bottom-4 left-4 text-white/90 font-display text-2xl drop-shadow">HOME</div>
    </div>
  </div>
</section>

---
import { getDict, type Lang } from '~/i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = getDict(lang);
const year = new Date().getFullYear();
---
<footer class="relative bg-bark text-mist mt-24 pt-20 pb-10 overflow-hidden">
  <svg class="absolute -top-px inset-x-0 w-full text-bark" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,80 C240,0 480,0 720,40 C960,80 1200,80 1440,20 L1440,80 L0,80 Z" fill="currentColor" />
  </svg>
  <div class="mx-auto max-w-7xl px-6 grid gap-12 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-2">
        <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
          <path d="M2 26 L10 12 L16 20 L22 8 L30 26 Z" fill="#E8DFCF" />
        </svg>
        <span class="font-display text-lg">Kamiyama Marugoto</span>
      </div>
      <p class="mt-4 text-mist/70 text-sm leading-relaxed">{d.disclaimer}</p>
    </div>
    <div class="text-sm">
      <p class="kicker text-sand">Navigate</p>
      <ul class="mt-3 space-y-2 text-mist/80">
        <li><a href="#about" class="hover:text-mist">{d.nav.about}</a></li>
        <li><a href="#curriculum" class="hover:text-mist">{d.nav.curriculum}</a></li>
        <li><a href="#admissions" class="hover:text-mist">{d.nav.admissions}</a></li>
        <li><a href="#access" class="hover:text-mist">{d.nav.access}</a></li>
      </ul>
    </div>
    <div class="text-sm">
      <p class="kicker text-sand">Connect</p>
      <ul class="mt-3 flex gap-3">
        <li><a href="#" aria-label="X / Twitter" class="rounded-full border border-mist/30 hover:border-mist p-2 inline-flex">𝕏</a></li>
        <li><a href="#" aria-label="Instagram" class="rounded-full border border-mist/30 hover:border-mist p-2 inline-flex">IG</a></li>
        <li><a href="#" aria-label="YouTube" class="rounded-full border border-mist/30 hover:border-mist p-2 inline-flex">YT</a></li>
        <li><a href="#" aria-label="GitHub" class="rounded-full border border-mist/30 hover:border-mist p-2 inline-flex">GH</a></li>
      </ul>
      <p class="mt-6 text-mist/60 text-xs">{d.footer.builtWith}</p>
    </div>
  </div>
  <div class="mx-auto max-w-7xl px-6 mt-12 pt-6 border-t border-mist/15 flex flex-wrap items-center justify-between gap-3 text-xs text-mist/60">
    <p>{d.footer.rights} · {year}</p>
    <p>Unofficial demo · Not affiliated with Kamiyama Marugoto College of Technology.</p>
  </div>
</footer>

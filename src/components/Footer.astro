---
import { useTranslations } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="mt-24 border-t border-forest-100 bg-forest-50/60">
  <div class="mx-auto max-w-6xl px-4 py-10 grid gap-6 md:grid-cols-2 text-sm">
    <div>
      <p class="font-display font-bold text-forest-700 text-lg">KAMIYAMA / Intro</p>
      <p class="mt-2 text-bark/70 max-w-md">{t.footer.disclaimer}</p>
    </div>
    <div class="md:text-right text-bark/60 self-end">
      <p>
        <a
          href={lang === 'ja' ? 'https://kamiyama.ac.jp/' : 'https://kamiyama.ac.jp/en/'}
          class="underline hover:text-forest-700"
          target="_blank"
          rel="noopener noreferrer"
        >
          kamiyama.ac.jp ↗
        </a>
      </p>
      <p class="mt-2">{t.footer.copyright}</p>
    </div>
  </div>
</footer>

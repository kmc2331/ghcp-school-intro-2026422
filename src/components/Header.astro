---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { id: 'about', label: t.nav.about },
  { id: 'curriculum', label: t.nav.curriculum },
  { id: 'campus', label: t.nav.campus },
  { id: 'faculty', label: t.nav.faculty },
  { id: 'life', label: t.nav.life },
  { id: 'news', label: t.nav.news },
  { id: 'access', label: t.nav.access },
];
---

<header class="sticky top-0 z-30 backdrop-blur bg-white/70 border-b border-forest-100">
  <div class="mx-auto max-w-6xl px-4 h-16 flex items-center justify-between gap-4">
    <a href="#top" class="flex items-center gap-2 font-display font-bold text-forest-700">
      <span class="inline-block w-7 h-7 rounded-full bg-forest-500 ring-2 ring-forest-200"></span>
      <span class="text-base sm:text-lg">KAMIYAMA <span class="text-forest-400">/</span> Intro</span>
    </a>

    <nav aria-label="primary" class="hidden lg:flex items-center gap-5 text-sm">
      {links.map((l) => (
        <a href={`#${l.id}`} class="text-bark/80 hover:text-forest-700 transition-colors">
          {l.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher lang={lang} />
      <a
        href={lang === 'ja' ? 'https://kamiyama.ac.jp/' : 'https://kamiyama.ac.jp/en/'}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center text-sm font-medium px-3 py-1.5 rounded-full bg-forest-600 text-white hover:bg-forest-700 transition-colors"
      >
        {t.nav.official} ↗
      </a>
    </div>
  </div>
</header>

---
import { useTranslations } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="faculty" class="section-anchor py-20 md:py-28 bg-forest-50/60">
  <div class="mx-auto max-w-6xl px-4">
    <p class="text-xs tracking-[0.25em] text-forest-600 font-medium">04 / FACULTY</p>
    <h2 class="mt-2 text-3xl md:text-4xl font-bold text-forest-900">{t.faculty.heading}</h2>
    <p class="mt-4 max-w-3xl text-bark/80 leading-relaxed">{t.faculty.lead}</p>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {t.faculty.members.map((m) => (
        <article class="p-6 rounded-2xl bg-white border border-forest-100 shadow-sm">
          <div
            class="w-14 h-14 rounded-full bg-gradient-to-br from-forest-300 to-forest-600"
            aria-hidden="true"
          ></div>
          <h3 class="mt-4 font-bold text-forest-800">{m.name}</h3>
          <p class="text-xs text-forest-600 mt-1">{m.role}</p>
          <p class="mt-3 text-sm text-bark/75 leading-relaxed">{m.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

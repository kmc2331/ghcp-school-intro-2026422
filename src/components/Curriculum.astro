---
import { useTranslations } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="curriculum" class="section-anchor py-20 md:py-28 bg-forest-50/60">
  <div class="mx-auto max-w-6xl px-4">
    <p class="text-xs tracking-[0.25em] text-forest-600 font-medium">02 / CURRICULUM</p>
    <h2 class="mt-2 text-3xl md:text-4xl font-bold text-forest-900">{t.curriculum.heading}</h2>
    <p class="mt-4 max-w-3xl text-bark/80 leading-relaxed">{t.curriculum.lead}</p>

    <ol class="mt-12 grid gap-4 md:grid-cols-5">
      {t.curriculum.items.map((it) => (
        <li class="relative p-5 rounded-2xl bg-white border border-forest-100 shadow-sm">
          <p class="text-xs font-mono text-forest-500">{it.year}</p>
          <h3 class="mt-2 text-lg font-bold text-forest-800">{it.title}</h3>
          <p class="mt-2 text-sm text-bark/75 leading-relaxed">{it.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
